# Optional: you do NOT need this file for the simple dashboard-binding setup.
# If you prefer config-as-code, copy to wrangler.toml and fill in database_id.
name = "leverage-audit-pilot"
pages_build_output_dir = "public"
compatibility_date = "2026-08-12"

[[d1_databases]]
binding = "DB"
database_name = "leverage-audit"
database_id = "PASTE_YOUR_D1_DATABASE_ID_HERE"
