{
  "name": "leverage-audit-cloudflare-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Leverage Audit Pilot v0.1 for Cloudflare Pages + Functions + D1",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public --project-name leverage-audit-pilot",
    "db:remote": "wrangler d1 execute leverage-audit --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute leverage-audit --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "type": "module"
}
